# Preferred Development Ports (Self-healing: automatically finds next free port if occupied)
NEXT_PORT=3000
PG_PORT=5432

# Database Configuration (PostgreSQL / PGlite WASM Proxy)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/shikshasetu?schema=public&connection_limit=1&pgbouncer=true"

# Auth.js / NextAuth Configuration
AUTH_SECRET="shikshasetu_super_secret_session_token_32_bytes_long_key_2026"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage Provider Abstraction
STORAGE_PROVIDER="local"
STORAGE_BUCKET="shikshasetu-documents"
STORAGE_ACCESS_KEY="dummy_access_key"
STORAGE_SECRET_KEY="dummy_secret_key"

# Email Provider Abstraction
EMAIL_PROVIDER="console"
EMAIL_API_KEY="dummy_resend_api_key"
